# Required for Claude's pick (without it the app runs in "demo mode" and picks the closest place)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Required on Vercel: added automatically when you connect Upstash Redis (Vercel → Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local testing only: use made-up restaurants instead of OpenStreetMap
# PICKY_FAKE_PLACES=1
