# AI that makes the pick. OpenAI is used when its key is set.
# Without any key the app runs in "demo mode" and picks the closest place.
OPENAI_API_KEY=sk-proj-...
# Optional: override the model
# OPENAI_MODEL=gpt-5.4-mini

# Optional alternative: Claude (used only when OPENAI_API_KEY is not set)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Required on Vercel: added automatically when you connect Upstash Redis (Vercel → Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local testing only: use made-up restaurants instead of OpenStreetMap
# PICKY_FAKE_PLACES=1
